ring":"QuestionnaireResponse"}],"reference":{"reference":"QuestionnaireResponse/ci-scenario5"},"name":"ci-scenario5","description":"Example test case - Collect Information - Scenario 5 - QuestionnaireResponse","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-questionnaireresponse"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Patient"}],"reference":{"reference":"Patient/ci-scenario5-patient"},"name":"ci-scenario5-patient","description":"Example test case - Collect Information - Scenario 5 - Patient","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-patient"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Patient"}],"reference":{"reference":"Patient/ci-scenario6-patient"},"name":"ci-scenario6-patient","description":"Example test case - Collect Information - Scenario 6 - Patient","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-patient"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Patient"}],"reference":{"reference":"Patient/ci-scenario7-patient"},"name":"ci-scenario7-patient","description":"Example test case - Collect Information - Scenario 7 - Patient","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-patient"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"PlanDefinition"}],"reference":{"reference":"PlanDefinition/cc-cpg-plan-ckd"},"name":"CKD Ambulatory Plan Definition","description":"Chronic Kidney Disease - Ambulatory","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-ordersetdefinition"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cc-cpg-activity-referral-dietitian"},"name":"CKD Referral Dietitian","description":"Referral: Dietitian; History: chronic kidney disease; Question: [add reason for referral]","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-computableactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cc-cpg-activity-referral-nephrology"},"name":"CKD Referral Nephrology","description":"Referral: Nephrology; History: [add diagnosis, symptom(s)]; Question: [add reason for referral]","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-computableactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"PlanDefinition"}],"reference":{"reference":"PlanDefinition/va-ckd-recommendations"},"name":"CKD VA Recommendations Plan Definition","description":"VA CKD Recommendations","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-recommendationdefinition"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Library"}],"reference":{"reference":"Library/collectinformation-library"},"name":"Collect Information Library","description":"Logic for an example recommendation to collect information","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"PlanDefinition"}],"reference":{"reference":"PlanDefinition/chf-pathway"},"name":"Congestive Heart Failure Care Pathway","description":"Treatment and management care pathway for patients with admitting diagnosis of congestive heart failure","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-pathwaydefinition"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Composition"}],"reference":{"reference":"Composition/chf-scenario1-casesummary"},"name":"Congestive Heart Failure Case Summary","description":"CHF Scenario One","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-casesummary"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Composition"}],"reference":{"reference":"Composition/chf-scenario1-caseplanprogressingnote"},"name":"Congestive Heart Failure Case/Plan Progressing Note","description":"CHF Scenario One","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-caseplanprogressingnote"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Composition"}],"reference":{"reference":"Composition/chf-scenario1-caseplansummary"},"name":"Congestive Heart Failure Case/Plan Summary","description":"CHF Scenario One","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-caseplansummary"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Library"}],"reference":{"reference":"Library/CHF"},"name":"Congestive Heart Failure Logic","description":"Logic for an example congestive heart failure pathway","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/cpg-active-condition-vs"},"name":"CPG Active Condition Value Set","description":"Active condition clinical status codes","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CodeSystem"}],"reference":{"reference":"CodeSystem/cpg-activity-type-cs"},"name":"CPG Activity Type Code System","description":"A type of activity that can be performed as part of the delivery of guideline-based care.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/cpg-activity-type-vs"},"name":"CPG Activity Type Value Set","description":"A type of activity that can be performed as part of the delivery of guideline-based care","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"OperationDefinition"}],"reference":{"reference":"OperationDefinition/cpg-activitydefinition-apply"},"name":"CPG ActivityDefinition Apply","description":"The apply operation applies a activityDefinition to a given context","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-administermedicationactivity"},"name":"CPG Administer Medication Activity","description":"Definition of a proposal to administer a medication as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-administermedication-activitydefinition"},"name":"CPG Administer Medication ActivityDefinition","description":"Example Activity Definition for a recommendation to administer a medication","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-administermedicationactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-administermedicationtask"},"name":"CPG Administer Medication Task","description":"Recommendation to administer a specific medication as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-answerValueSetSource"},"name":"CPG Answer Value Set Source Extension","description":"The canonical URL for the source value set for the answer options, when those options are provided directly in the questionnaire.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-assertionExpression"},"name":"CPG Assertion Expression Extension","description":"Defines formal computational semantics for the feature if it is asserted. This is typically only required if the case feature is of a different type than the profile (e.g. a boolean feature).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-careplan"},"name":"CPG Care Plan","description":"CPG care plan represents the care plan for a specific patient. The care plan may be associated with management of a specific condition, and instantiated based on a particular pathway or strategy, or it may be a combined care plan, focused on the patient, and managing treatment for multiple conditions, instantiated based on multiple pathways and strategies","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-careteam"},"name":"CPG Care Team","description":"CPG care team represents a care team for a specific patient","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-careteamdefinition"},"name":"CPG Care Team Definition","description":"Defines the minimum expectations for a definitional care team for use with computable guideline content","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-case"},"name":"CPG Case","description":"CPG case represents a specific case of a patient enrolled in a particular pathway. The enrollment may have been automatic, prompted, or manual.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-casefeaturedefinition"},"name":"CPG Case Feature Definition","description":"Profile of StructureDefinition to represent a case feature of a clinical practice guideline, optionally specifying formal computational semantics, as well as relationships to other case features and specific aspects of the guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-caseFeatureOf"},"name":"CPG Case Feature Of Extension","description":"Defines which guideline elements this case feature definition is a feature of.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CodeSystem"}],"reference":{"reference":"CodeSystem/cpg-casefeature-pertinence-cs"},"name":"CPG Case Feature Pertinence Code System","description":"The pertinence of a case feature relative to a case, guideline, pathway, strategy, or recommendation.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-caseFeaturePertinence"},"name":"CPG Case Feature Pertinence Extension","description":"Describes the pertinence of the case feature.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/cpg-casefeature-pertinence-vs"},"name":"CPG Case Feature Pertinence Value Set","description":"A type of activity that can be performed as part of the delivery of guideline-based care","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CodeSystem"}],"reference":{"reference":"CodeSystem/cpg-casefeature-type-cs"},"name":"CPG Case Feature Type Code System","description":"The type of a case feature, whether asserted (i.e. documented in the patient's record) or inferred (i.e. calculated from the case feature expression)","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-caseFeatureType"},"name":"CPG Case Feature Type Extension","description":"Describes whether the case feature is asserted or inferred.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/cpg-casefeature-type-vs"},"name":"CPG Case Feature Type Value Set","description":"A type of activity that can be performed as part of the delivery of guideline-based care","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-caseplanprogressingnote"},"name":"CPG Case Plan Progressing Note","description":"CPG Case Plan Progressing Note combines relevant case features and feature groups with proposals, plans, and clinical impressions to provide a means to document patient progression with respect to a pathway in the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-caseplansummary"},"name":"CPG Case Plan Summary","description":"CPG Case Plan Summary addresses information from the plan portion of the CPG, including patient-specific recommendations (i.e., proposals) along with their respective pertinent patient information and guideline recommendations that are either not applicable or not yet applicable to a specific patient","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-caseplansummarydefinition"},"name":"CPG Case Plan Summary Definition","description":"CPG Case Plan Summary Definition provides a computable definition for the case features and feature groups relevant to a particular pathway, strategy, or recommendation of a clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-casesummary"},"name":"CPG Case Summary","description":"CPG Case Summary is the set of case features and feature groups that completely represent the case data scoped by the clinical practice guideline. This expresses the complete patient state at any given point in time.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-casesummarydefinition"},"name":"CPG Case Summary Definition","description":"CPG Case Summary Definition provides a computable definition for all the case features and feature groups relevant to a clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-clinicalimpression"},"name":"CPG Clinical Impression","description":"CPG Clinical Impression captures clinician judgement at any particular point, and related to the case features and pathway, strategies, and recommendations.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-collectinformationactivity"},"name":"CPG Collect Information Activity","description":"Definition of a recommendation to collect information using a specific questionnaire as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-collectWith"},"name":"CPG Collect With Extension","description":"The URL of the questionnaire to be used to collect the information. If this information is not supplied as part of the activity definition, it is expected to be determined dynamically as part of realizing the activity.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-collectinformation-activitydefinition"},"name":"CPG CollectInformation ActivityDefinition","description":"Example Activity Definition for a recommendation to collect information","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-collectinformationactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"PlanDefinition"}],"reference":{"reference":"PlanDefinition/cpg-common-pathway"},"name":"CPG Common Pathway","description":"Common patient care pathway","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CapabilityStatement"}],"reference":{"reference":"CapabilityStatement/cpg-common-patient-registry"},"name":"CPG Common Patient Registry","description":"Describes the expected set of functionality required for a patient registry service that supports the common registration process defined in this implementation guide.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"OperationDefinition"}],"reference":{"reference":"OperationDefinition/cpg-common-patient-summary"},"name":"CPG Common Patient Summary","description":"The summary operation generates a patient summary for a patient","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/cpg-common-persona-vs"},"name":"CPG Common Persona Value Set","description":"Common personas used to describe roles and participants in computable content","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CodeSystem"}],"reference":{"reference":"CodeSystem/cpg-common-persona-cs"},"name":"CPG Common Personas Code System","description":"Personas are the types of participants in the recommendations of a healthcare guideline, including practitioners, patients, nurses, community health workers, and care partners. The personas identified in this code system are defined based on the WHO recommendation for [Classifying health workers](https://www.who.int/hrh/statistics/Health_workers_classification.pdf). This recommendation uses codes from the [International Standard Classification for Occupations](http://www.ilo.org/public/english/bureau/stat/isco/index.htm) but defines several additional categories of health workers. In addition, the codes in that recommendation are focused on health workers, so codes for patient and care partner personas need to be considered as well. Where a code from the ISCO exists, it is used. Where a WHO recommended health worker category is used, a code is constructed beginning with a W. Where a code is introduced by this implementation guide, it is constructed beginning with a C. Note that the content is incomplete, pending a computable representation of the WHO recommendations.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CodeSystem"}],"reference":{"reference":"CodeSystem/cpg-common-process-cs"},"name":"CPG Common Process Code System","description":"Common processes performed in providing guideline-based care, regardless of the specific guideline.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/cpg-common-process-vs"},"name":"CPG Common Process Value Set","description":"Common processes used to describe the high-level, conceptual activities that occur as part of the delivery of guideline-based care","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Questionnaire"}],"reference":{"reference":"Questionnaire/cpg-common-identity"},"name":"CPG Common Questionnaire - Identifying information","description":"Questionnaire used to identify patient","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Questionnaire"}],"reference":{"reference":"Questionnaire/cpg-common-patient-profile"},"name":"CPG Common Questionnaire - Patient information","description":"Questionnaire to gather patient infomration","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Questionnaire"}],"reference":{"reference":"Questionnaire/cpg-common-resolve-patient-match"},"name":"CPG Common Questionnaire - Resolve Patient Match","description":"Questionnaire to resolve patient","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-communication"},"name":"CPG Communication","description":"Documents a communication with a patient or other participant as an activity within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-communicationactivity"},"name":"CPG Communication Activity","description":"Definition of a recommendation for a specific communication with the patient or other participant as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-communicationrequest"},"name":"CPG Communication Request","description":"Recommendation for a specific communication with the patient or other participant as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-communicationrequest-activitydefinition"},"name":"CPG CommunicationRequest ActivityDefinition","description":"Example Activity Definition for a recommendation to send a message","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-communicationactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-computableactivity"},"name":"CPG Computable Activity Definition","description":"Defines the minimum expectations and behavior for a computable activity definition for use with content conforming to the CPG implementation guide","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-computablegraphdefinition"},"name":"CPG Computable Graph Definition","description":"Profile of GraphDefinition to establish computable expectations for the use of the GraphDefinition resource","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-computableguideline"},"name":"CPG Computable Guideline","description":"Profile of ImplementationGuide to describe a computable Clinical Practice Guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-computablemetric"},"name":"CPG Computable Metric","description":"Defines the minimum expectations and behavior for a computable metric for use with content conforming to the CPG implementation guide","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-computableplandefinition"},"name":"CPG Computable Plan Definition","description":"Defines the minimum expectations and behavior for a computable plan definition","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-computablequestionnaire"},"name":"CPG Computable Questionnaire","description":"Profile of Questionnaire to establish minimum expectations for a Questionnaire for use with computable guideline content","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-condition"},"name":"CPG Condition","description":"CPG condition represents the minimum expectations for communicating condition/problem information as part of a CPG case","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-detectedissue"},"name":"CPG Detected Issue","description":"Documents a detected issue within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-directionOfRecommendation"},"name":"CPG Direction Of Recommendation Extension","description":"Specifies whether the recommendation is \"for\" or \"against\" a particular activity. For example, the recommendation to prescribe a particular medication, versus the recommendation not to perform a particular procedure.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-dispensemedicationactivity"},"name":"CPG Dispense Medication Activity","description":"Definition of an activity to dispense a specific medication as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-dispensemedication-activitydefinition"},"name":"CPG Dispense Medication ActivityDefinition","description":"Example Activity Definition for a recommendation to dispense a medication","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-dispensemedicationactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-dispensemedicationtask"},"name":"CPG Dispense Medication Task","description":"Recommendation to dispense a specific medication as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-documentmedicationactivity"},"name":"CPG Document Medication Activity","description":"Definition of an activity to document a specific medication as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-documentmedication-activitydefinition"},"name":"CPG Document Medication ActivityDefinition","description":"Example Activity Definition for a recommendation to document a medication","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-documentmedicationactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-documentmedicationtask"},"name":"CPG Document Medication Task","description":"Recommendation to document the use of a specific medication as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-enabled"},"name":"CPG Enabled Extension","description":"Determines whether the artifact on which it appears is Enabled, as opposed to just Known.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-encounter"},"name":"CPG Encounter","description":"CPG encounter represents the minimum expectations for communicating encounter information as part of a CPG case","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-enrollIn"},"name":"CPG Enroll In Extension","description":"The URL of the PlanDefinition (Strategy or Pathway) in which the patient should be enrolled.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-enrolledIn"},"name":"CPG Enrolled In Extension","description":"Tracks the episode of care for a particular patient enrolled in a particular pathway.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-enrollmentactivity"},"name":"CPG Enrollment Activity","description":"Definition of an activity to enroll or unenroll a patient in a strategy or pathway as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-enrollment-activitydefinition"},"name":"CPG Enrollment ActivityDefinition","description":"Example Activity Definition for a recommendation to enroll patient","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-enrollmentactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-enrollmenttask"},"name":"CPG Enrollment Task","description":"Proposal to enroll the patient in a strategy or pathway as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-featureExpression"},"name":"CPG Feature Expression Extension","description":"Defines formal computational semantics for the feature, combining the inference and assertion expressions. This is typically only required if the feature is of a different type than the profile (e.g. a boolean feature).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-flag"},"name":"CPG Flag","description":"Represents a flag on a patient record within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-generatereportactivity"},"name":"CPG Generate Report Activity","description":"Definition of an activity to generate a metric, measure, or case report as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-generatereport-activitydefinition"},"name":"CPG Generate Report ActivityDefinition","description":"Example Activity Definition for a recommendation to generate a report","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-generatereportactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-generatereporttask"},"name":"CPG Generate Report Task","description":"Proposal to generate a metric, measure, or case report as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-generatedFrom"},"name":"CPG Generated From Extension","description":"Defines which definitional artifact was used to generated the resource.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-goal"},"name":"CPG Goal","description":"Defines the expectations for the representation of goals used in computable guidelines","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-goalFor"},"name":"CPG Goal For Extension","description":"The URL of the PlanDefinition (recommendation, strategy, or pathway) that the goal is related to, or defined in support of.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-group"},"name":"CPG Group","description":"Defines an actual group of subjects, suitable for use in various contexts, such as a enrollment in a pathway or participant in a study","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-groupdefinition"},"name":"CPG Group Definition","description":"Represents the definition of a group of subjects, suitable for use in various contexts, such as a cohort definition, a recommendation inclusion or exclusion criteria, the members of a study, or a population criteria","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-holdactivity"},"name":"CPG Hold Activity","description":"Definition of a recommendation to hold an activity that is currently in progress as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-holdtask"},"name":"CPG Hold Task","description":"Recommendation to hold an activity that is currently in progress as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-immunization"},"name":"CPG Immunization","description":"Documents a particular immunization as an activity within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-immunizationactivity"},"name":"CPG Immunization Activity","description":"Definition of a recommendation for a particular immunization as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-immunizationrequest"},"name":"CPG Immunization Request","description":"Recommendation for a particular immunization as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-immunizationrequest-activitydefinition"},"name":"CPG ImmunizationRequest ActivityDefinition","description":"Example Activity Definition for a recommendation to provide an immunization","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-immunizationactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-impressionFor"},"name":"CPG Impression For Extension","description":"Specifies a case (episode of care) which this clinical impression is for.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-inferenceExpression"},"name":"CPG Inference Expression Extension","description":"Defines formal computational semantics for calculating the case feature if it is not asserted.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-instantiatesCaseFeature"},"name":"CPG Instantiates Case Feature Extension","description":"References the definition for this case feature.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-isUnenrollment"},"name":"CPG Is Unenrollment Extension","description":"Determines whether the activity is to enroll or unenroll the patient in the specified strategy or pathway.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-itemImage"},"name":"CPG Item Image Extension","description":"An image to display as a visual accompaniment to the question being asked.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-location"},"name":"CPG Location","description":"CPG location represents the minimum expectations for communicating location information as part of a CPG case","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-locationdefinition"},"name":"CPG Location Definition","description":"CPG location represents the minimum expectations for communicating a definitional location as part of computable guideline content","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-medicationadministration"},"name":"CPG Medication Administration","description":"Documents the administration of a particular medication as an activity within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-medicationdispense"},"name":"CPG Medication Dispense","description":"Documents the dispensing of a particular medication as an activity within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-medicationrequest"},"name":"CPG Medication Request","description":"Recommendation for a specific medication as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-medicationrequestactivity"},"name":"CPG Medication Request Activity","description":"Definition of a recommendation for a specific medication as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-medicationstatement"},"name":"CPG Medication Statement","description":"Documentation of the use of a particular medication as an activity within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-medicationrequest-activitydefinition"},"name":"CPG MedicationRequest ActivityDefinition","description":"Example Activity Definition for a recommendation to request a medication","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-medicationrequestactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-metricreport"},"name":"CPG Metric Report","description":"Records a contextualized metric as calculated within the context of the implementation of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-observation"},"name":"CPG Observation","description":"Documents a specific observation as an activity within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-ordersetdefinition"},"name":"CPG Order Set Definition","description":"Profile of PlanDefinition as a Order Set for use with CPG Implementation Guide","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-organization"},"name":"CPG Organization","description":"CPG organization represents the minimum expectations for communicating organization information as part of a CPG case","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-partOf"},"name":"CPG Part Of Extension","description":"Specifies the canonical URL of a Pathway or Strategy that this definition is part of.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-participantCapabilityStatement"},"name":"CPG Participant Capability Statement Extension","description":"A CapabilityStatement that specifies what capabilities a device must have in order to participant in this action of a PlanDefinition.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-pathwaydefinition"},"name":"CPG Pathway Definition","description":"Profile of PlanDefinition as a Clinical Pathway for use with CPG Implementation Guide. A pathway provides groupings of strategies to provide a longitudinal view of the guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-patient"},"name":"CPG Patient","description":"Profile of Patient for use with CPG Implementation Guide","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-pertinent"},"name":"CPG Pertinent Extension","description":"The pertinent positive or negative information relevant to the recommendation.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-planFor"},"name":"CPG Plan For Extension","description":"Specifies a case (episode of care) which this care plan is managing.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"OperationDefinition"}],"reference":{"reference":"OperationDefinition/cpg-plandefinition-apply"},"name":"CPG PlanDefinition Apply","description":"The apply operation applies a PlanDefinition to a given context","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-practitioner"},"name":"CPG Practitioner","description":"Profile of Practitioner for use with CPG Implementation Guide","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-practitionerrole"},"name":"CPG Practitioner Role","description":"Profile of PractitionerRole for use with CPG Implementation Guide","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-practitionerroledefinition"},"name":"CPG Practitioner Role Definition","description":"Profile of PractitionerRole to establish definitional practitioner roles with the CPG Implementation Guide","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-procedure"},"name":"CPG Procedure","description":"Documents a procedure as an activity within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-proposediagnosisactivity"},"name":"CPG Propose Diagnosis Activity","description":"The definition of a recommendation to propose a specific diagnosis as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-proposediagnosistask-activitydefinition"},"name":"CPG Propose Diagnosis ActivityDefinition","description":"Example Activity Definition for a recommendation to propose a diagnosis","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-proposediagnosisactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-proposediagnosistask"},"name":"CPG Propose Diagnosis Task","description":"Recommendation to propose a specific diagnosis as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-questionnaireresponse"},"name":"CPG Questionnaire Response","description":"The response to a particular questionnaire as an activity within the context of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-questionnairetask"},"name":"CPG Questionnaire Task","description":"Recommendation to collect specific information using a particular questionnaire as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-rating"},"name":"CPG Rating Extension","description":"A clinician-friendly rating, or score, for the recommendation; patient-friendly if the recommendation is patient-facing.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-rationale"},"name":"CPG Rationale Extension","description":"A clinician-friendly explanation for the recommendation; patient-friendly if the recommendation is patient-facing.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-recommendationdefinition"},"name":"CPG Recommendation Definition","description":"Profile of PlanDefinition as a Recommendation Definition for use with CPG Implementation Guide","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CodeSystem"}],"reference":{"reference":"CodeSystem/cpg-recommendation-direction-cs"},"name":"CPG Recommendation Direction Code System","description":"The direction of a recommendation, either for or against a particular action, taking into account the balance between desirable and undersirable outcomes; the confidence in the magnitude of estimates of effect; the confidence in values and preferences and their variability; and resource use.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/cpg-recommendation-direction-vs"},"name":"CPG Recommendation Direction Value Set","description":"The direction of a recommendation, either for or against a particular action, taking into account the balance between desirable and undersirable outcomes; the confidence in the magnitude of estimates of effect; the confidence in values and preferences and their variability; and resource use.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-recorddetectedissueactivity"},"name":"CPG Record Detected Issue Activity","description":"Definition of a recommendation to record a specific detected issue as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-recorddetectedissuetask"},"name":"CPG Record Detected Issue Task","description":"Recommendation to record a specific detected issue as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-recorddetectedissue-activity"},"name":"CPG Record DetectedIssue ActivityDefinition","description":"Example Activity Definition for a recommendation to record a detected issue","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-recorddetectedissueactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-recordinferenceactivity"},"name":"CPG Record Inference Activity","description":"Definition of a recommendation to record a specific inference as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-recordinference-activity"},"name":"CPG Record Inference ActivityDefinition","description":"Example Activity Definition for a recommendation to record an inference","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-recordinferenceactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-recordinferencetask"},"name":"CPG Record Inference Task","description":"Recommendation to record a particular inference as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-relatedperson"},"name":"CPG Related Person","description":"CPG related person defines the minimum expectations for a person related to a patient in a CPG case, such as a care partner, spouse, or other related person","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-reportflagactivity"},"name":"CPG Report Flag Activity","description":"Definition of a recommendation to report a particular flag as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-reportflagtask-activitydefinition"},"name":"CPG Report Flag ActivityDefinition","description":"Example Activity Definition for a recommendation to report a flag","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-reportflagactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-reportflagtask"},"name":"CPG Report Flag Task","description":"Recommendation to report a flag as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-reportWith"},"name":"CPG Report With Extension","description":"The URL of the artifact that describes the report to be sent, a metric or measure, case report, or profile that describes the data to be reported.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:extension"}],"reference":{"reference":"StructureDefinition/cpg-responseImage"},"name":"CPG Response Image Extension","description":"An image to display as a visual accompaniment to the response.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-resumeactivity"},"name":"CPG Resume Activity","description":"Definition of a recommendation to resume an activity that is currently on hold as part of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-resumetask"},"name":"CPG Resume Task","description":"Recommendation to resume an activity that is currently on hold as part of the delivery of a computable clinical practice guideline","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-servicerequest"},"name":"CPG Service Request","description":"Recommendation for a particular procedure or referral to a specialist or instructions for self-care such as smoking cessation counseling or exercise","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-servicerequestactivity"},"name":"CPG Service Request Activity","description":"The definition of a recommendation for a particular procedure or referral to a specialist or instructions for self-care such as smoking cessation counseling or exercise","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActivityDefinition"}],"reference":{"reference":"ActivityDefinition/cpg-servicerequest-activitydefinition"},"name":"CPG ServiceRequest ActivityDefinition","description":"Example Activity Definition for a recommendation to request a service","exampleCanonical":"http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-servicerequestactivity"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/cpg-stopactivity"},"name":"CPG Stop Activity","description":"Definition of a recommendation to stop an activity that is currently in progress as part of a computable clin